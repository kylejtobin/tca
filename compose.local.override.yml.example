# TCA app stack — operator-local override (template).
#
# Copy to compose.local.override.yml (gitignored) and edit for your local
# environment. Layered automatically by scripts/compose.sh on every
# invocation when the file exists on disk. Use for anything operator-specific
# that should not enter the committed vocabulary — extra docker networks,
# extra volume mounts, etc.

# networks:
#   <your-network>:
#     name: <your-network>
#     external: true
#
# services:
#   app:
#     networks:
#       - tca-env
#       - <your-network>
