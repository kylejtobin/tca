# TCA DEV environment config — template.
#
# Copy to env/.env.dev and fill in secrets. Generate randoms with
# `openssl rand -hex 32`. The real env/.env.dev is gitignored.
#
# Consumed by compose.yml + compose.dev.override.yml.

# ----------------------------------------------------------------------------
# Environment identity — drives container names and the per-env network.
# ----------------------------------------------------------------------------
ENV_NAME=dev

# App Docker build target — `dev` retains build tools and uses --reload.
APP_BUILD_TARGET=dev

# ----------------------------------------------------------------------------
# NATS
# ----------------------------------------------------------------------------
NATS_USER=tca
NATS_PASSWORD=                               # openssl rand -hex 32
