# TCA PROD environment config — template.
#
# Copy to env/.env.prod and fill in secrets. Generate randoms with
# `openssl rand -hex 32`. The real env/.env.prod is gitignored.
#
# Consumed by compose.yml.

# ----------------------------------------------------------------------------
# Environment identity — drives container names and the per-env network.
# ----------------------------------------------------------------------------
ENV_NAME=prod

# App Docker build target — `prod` COPYs source into the image at build time.
APP_BUILD_TARGET=prod

# ----------------------------------------------------------------------------
# NATS
# ----------------------------------------------------------------------------
NATS_USER=tca
NATS_PASSWORD=                               # openssl rand -hex 32
