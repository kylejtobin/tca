# The model the TCA agent speaks to, as pydantic_ai names it: a provider, a colon and the model's name.
# Its provider reads its own credentials and endpoint below. One an OpenAI-compatible endpoint serves,
# as Workers AI does, is openai-chat:<its name there>, with OPENAI_BASE_URL and OPENAI_API_KEY set to it.
TCA_AGENT__MODEL=openai-chat:@cf/zai-org/glm-5.3-flash

# The workspace the TCA agent models in, and its boundary. The directory holds the skills under .agents/skills,
# its check as an executable named check at its root, and the work; the agent reads and runs whatever is
# there, so it never holds this file or a key. The kind is local, isolating nothing, or sandbox, every command
# in pydantic_ai's bubblewrap sandbox: the host read-only, no network, writes only inside the directory; it
# needs bwrap on the machine. The check exits zero only when the work is clean, and in a sandbox writes
# nothing outside the directory.
TCA_AGENT__WORKSPACE__KIND=sandbox
TCA_AGENT__WORKSPACE__PATH=workspace

# Where tca-agent exports its traces: any OpenTelemetry collector, or Logfire by its token; with neither, nowhere.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LOGFIRE_TOKEN=

# The named provider's credentials, under that provider's own names; pydantic_ai reads them itself.
OPENAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account>/ai/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=

# The registrar the reference program speaks to: its address and its key.
REGISTRAR__URL=https://registrar.example
REGISTRAR__KEY=

# The judge the eval speaks to, as pydantic_ai names it; a different model from the agent's.
EVAL_JUDGE__MODEL=anthropic:claude-opus-5-5

# Where Inspect writes its logs; Inspect reads it itself.
INSPECT_LOG_DIR=logs
