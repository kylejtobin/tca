# The model the TCA agent speaks to, as pydantic_ai names it: its provider, a colon, and the model's name.
# Workers AI has no provider of its own; it speaks chat completions, named under openai-chat with its base URL below.
TCA_AGENT__MODEL=openai-chat:@cf/zai-org/glm-5.3-flash

# How hard the model thinks, as pydantic_ai names the levels: minimal, low, medium, high or xhigh.
TCA_AGENT__THINKING=low

# How many model requests one run of the agent may make before it is stopped.
TCA_AGENT__REQUESTS=20

# The named provider's credentials, under that provider's own names; pydantic_ai reads them itself.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account>/ai/v1
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=

# The registrar the reference program speaks to: its address and its key.
REGISTRAR__URL=https://registrar.example
REGISTRAR__KEY=

# The judge the eval speaks to, as pydantic_ai names it; a different model from the agent's.
EVAL_JUDGE__MODEL=anthropic:claude-opus-5-5

# Where Inspect writes its logs; Inspect reads it itself.
INSPECT_LOG_DIR=logs
