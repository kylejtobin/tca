{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit",
      "Write",
      "Read(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Agent(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python .claude/scripts/tca_gate.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
