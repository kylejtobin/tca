{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Agent(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Bash(just *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(pip *)",
      "Bash(pip3 *)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "."
      ]
    }
  }
}
