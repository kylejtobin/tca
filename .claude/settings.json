{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Agent(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Bash(just *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(pip *)",
      "Bash(pip3 *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": ["~/", "/mnt", "/media", "/run/media", "/srv"],
      "allowRead": ["."]
    },
    "excludedCommands": [
      "just *",
      "git commit *",
      "git push *",
      "uv *",
      "docker *"
    ]
  }
}
