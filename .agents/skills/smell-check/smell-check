#!/usr/bin/env python3
"""smell-check: seven line patterns that mark procedure on a TCA page, each with the type to write instead.

Usage: smell-check <path>...   Per hit: LABEL file:line: text, then the instruction. Exit 1 on any hit.
"""

import re
import sys
from pathlib import Path

PROCEDURE = {
    "if": "a branch is a union: write the members that construct in each case and hold `A | B`",
    "for": "a loop is a tuple: hold `tuple[T, ...]` and put what the whole knows in a @computed_field",
    "while": "a loop is a tuple: hold `tuple[T, ...]` and put what the whole knows in a @computed_field",
    "try": "a failure is a refusal: delete the handler and let ValidationError or the client's exception propagate",
    "except": "a failure is a refusal: delete the handler and let ValidationError or the client's exception propagate",
    "raise": "a rule is a type: put the constraint in a Scalar's Field(...) or split the cases into union members",
    "None": "an absence is a class: name the absent case and hold it as a union member",
}
REFLECTION = {
    "lambda": "a function with no name: write the @computed_field or the field it stands for",
    "getattr": "a lookup by name: the field annotation already declares what is held; read it as a field",
    "setattr": "mutation: instances are frozen; construct the next fact holding this one",
    "hasattr": "a question about shape: the class declares its fields; hold the class that has the field",
    "vars": "a model read as a dict: use the fields",
    "isinstance": "a question about type: the union already chose the member; hold the member",
    "issubclass": "a question about type: declare the kind as a generic parameter and read it from the class",
    "create_model": "a class built at runtime: write the class",
    "TypeAdapter": "validation outside a model: every kind is a model; call model_validate_json on it",
    "**": "a dict nobody proved: write the fields, or the config keys, out in full",
}
RULES = [
    ("VALIDATOR", re.compile(r"\b(model_validator|field_validator|AfterValidator|BeforeValidator|WrapValidator|PlainValidator)\b"),
     lambda m: "a validator checks a value that already exists and returns the same type; the rule is a Scalar constraint, Field(gt=..., min_length=...), or two scalars with disjoint constraints held by two facts in a union"),
    ("WEAKENED", re.compile(r"\bAny\b|\bcast\(|#\s*type:\s*ignore|:\s*object\b|\[object\]"),
     lambda m: "the checker refused a type and the refusal is the specification; read basedpyright's message and write the type it names"),
    ("REFLECTION", re.compile(r"\b(lambda)\b|\b(getattr|setattr|hasattr|vars|isinstance|issubclass|create_model|TypeAdapter)\(|(\*\*)\w"),
     lambda m: REFLECTION[next(g for g in m.groups() if g)]),
    ("PROCEDURE", re.compile(r"^\s*(if|for|while|try|except|raise)\b|\b(None)\b"),
     lambda m: PROCEDURE[next(g for g in m.groups() if g)]),
    ("COMPUTATION", re.compile(r"\b(sum|min|max|len|sorted|abs|round|any|all|map|filter|zip|enumerate)\(|^\s*return\b.*\s[-+*/%]\s"),
     lambda m: "a computed field is a projection: it reads fields and constructs a declared class; a value computed from others is a derivation kind, a comparison a relation kind, a choice a selection kind, each declared once as a subclass"),
    ("PRIMITIVE", re.compile(r"^\s+(?!root\b)(\w+):\s*(str|int|float|bool|bytes|Decimal|datetime|date|UUID|timedelta)\b"),
     lambda m: f"`{m.group(1)}` has a meaning and a range the primitive does not carry: write `class {m.group(1).title().replace('_', '')}(Scalar[{m.group(2)}])` with its constraint in Field(...) and hold that"),
]
DEF = re.compile(r"^\s*(async\s+)?def\s+(\w+)")
DERIVATION = re.compile(r"^\s*@(property|computed_field)\b")
DECORATOR = re.compile(r"^\s*@")
METHOD = "`{name}` is a computation hung on a type: what a thing knows is a @computed_field reading self; what an action does is a @property the library kind declared; anything else is a class not yet written"


def scan(path: Path) -> list[str]:
    lines = path.read_text().splitlines()
    hits: list[str] = []
    for index, line in enumerate(lines, 1):
        if match := DEF.match(line):
            above = index - 2
            derived = False
            while above >= 0 and DECORATOR.match(lines[above]):
                derived = derived or bool(DERIVATION.match(lines[above]))
                above -= 1
            if not derived:
                hits.append(f"METHOD      {path}:{index}: {line.strip()}\n            {METHOD.format(name=match.group(2))}")
        for label, rule, advise in RULES:
            if match := rule.search(line):
                hits.append(f"{label:<11} {path}:{index}: {line.strip()}\n            {advise(match)}")
    return hits


def main(argv: list[str]) -> int:
    files = sorted(f for a in map(Path, argv) for f in ([a] if a.is_file() else a.rglob("*.py")))
    hits = [h for f in files for h in scan(f)]
    print("\n".join(hits))
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
