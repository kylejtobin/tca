#!/usr/bin/env bash
# smell-check: find the five procedural patterns in TCA Python code.
# Usage: smell-check <path>...   Exit 1 if anything is found, 0 if clean.
# Every hit is a violation. There is no severity. Fix the model, not the line.
set -u
if [ "$#" -eq 0 ]; then
  echo "usage: smell-check <path>..." >&2
  exit 2
fi

found=0
scan() {
  local label="$1" pattern="$2"; shift 2
  local out
  out="$(rg -n --no-heading --color never -g '*.py' -g '!**/parser/**' "$@" -e "$pattern" -- "${PATHS[@]}" 2>/dev/null)"
  if [ -n "$out" ]; then
    found=1
    printf '%s\n' "$out" | sed "s/^/${label}  /"
  fi
}
PATHS=("$@")

# 1. FREE FUNCTION: a def at column 0. The only admitted one is the callback in main.py.
scan 'FREE-FUNCTION ' '^(async )?def ' -g '!main.py'
# main.py admits one def. A second def there is a free function wearing the callback's exemption.
while IFS= read -r mainpy; do
  [ -z "$mainpy" ] && continue
  if [ "$(rg -c '^(async )?def ' -- "$mainpy" 2>/dev/null || echo 0)" -gt 1 ]; then
    found=1
    rg -n --no-heading --color never -e '^(async )?def ' -- "$mainpy" | sed "s|^|FREE-FUNCTION  ${mainpy}:|"
  fi
done <<< "$(rg --files -g 'main.py' -- "${PATHS[@]}" 2>/dev/null)"

# 2. ISINSTANCE: asking a value what it is. It already said, by existing as its variant.
scan 'ISINSTANCE    ' '\bisinstance\('

# 3. LOOP: a fold with no name.
scan 'LOOP          ' '^\s*(async\s+)?for\s.*:\s*(#.*)?$|^\s*while\s.*:\s*(#.*)?$'

# 4. CONDITIONAL: a branch. The only branch is construction choosing a union variant.
scan 'CONDITIONAL   ' '^\s*(if|elif)\b|^\s*else\s*:|^\s*match\b.*:\s*$|^\s*case\b.*:\s*$|\sif\s.+\selse\s|\sfor\s.+\sif\s'

# 5. DICT: a shape nobody proved. JsonValue and Json[...] are the same shape under a Pydantic name.
scan 'DICT          ' '\bdict\[|\bdict\(|[=:(,]\s*\{|\breturn\s+\{|\bJsonValue\b|\bJson\[|\bMapping\b|\bMutableMapping\b|\bOrderedDict\b|\bdefaultdict\b|\bTypedDict\b|\bChainMap\b'

# 5b. LIST, SET, ANY, TYPEADAPTER: a shape that is not one of your classes.
scan 'LIST          ' '\blist\[|\blist\(|[=:(,]\s*\[|\breturn\s+\['
scan 'SET           ' '\bset\[|\bset\(|\bfrozenset\b'
scan 'ANY           ' '\bAny\b'
scan 'TYPEADAPTER   ' '\bTypeAdapter\b'

# 6. PARSE METHOD: procedure hung on a model. A derivation takes only self and returns one expression.
scan 'PARSE-METHOD  ' 'def \w+\(\s*self\s*,|@staticmethod|validator|\bstr\('

# 7. CATCH: nothing is caught and the program raises nothing.
scan 'CATCH         ' '^\s*try\s*:|^\s*except\b|^\s*finally\s*:|^\s*raise\b|\braise_for_status\b'

# 8. NONE: absence is a named class.
scan 'NONE          ' '\|\s*None\b|\bNone\s*\||\bOptional\['

# 9. LAMBDA: a function with no name, or an untyped parameter list.
scan 'LAMBDA        ' '\blambda\b[^:\n]*:|\*args\b|\*\*kwargs\b'

# 10. JSON: raw text goes to a constructor; a model serialises itself.
scan 'JSON          ' '\bjson\.(loads|dumps)\('

# 11. BYPASS: construction skipped, mutated, or state kept outside a value.
scan 'BYPASS        ' '\bmodel_construct\b|\bmodel_copy\(|\bPrivateAttr\b|\bcached_property\b|\blru_cache\b|object\.__setattr__|\bmodel_post_init\b|def __init__\(|\bSkipValidation\b|^\s*(global|nonlocal)\s'

# 12. PARSER-IMPORT: a format is read only by a foreign model. Files under parser/ are not scanned.
scan 'PARSER-IMPORT ' '^\s*(from|import)\s+parser\b' -g '!**/integration/*/model.py'

exit "$found"
